# ==============================================================================
# Viral Thread Generator - Environment Configuration Template
# Copy this file to `.env.local` and fill in your actual API keys and endpoints.
# NEVER commit `.env.local` or any file containing actual secret keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# Convex Backend Configuration
# Obtain via `pnpm convex dev` or from your Convex dashboard: https://dashboard.convex.dev
# ------------------------------------------------------------------------------
CONVEX_DEPLOYMENT=dev:your-convex-deployment-id
CONVEX_URL=https://your-convex-deployment.convex.cloud
CONVEX_SITE_URL=https://your-convex-deployment.convex.site
NEXT_PUBLIC_CONVEX_URL=https://your-convex-deployment.convex.cloud

# ------------------------------------------------------------------------------
# Meta Threads API Configuration
# Register an app at https://developers.facebook.com to obtain Threads API credentials.
# ------------------------------------------------------------------------------
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=https://your-convex-deployment.convex.site/auth

# ------------------------------------------------------------------------------
# AI & LLM Provider API Keys
# ------------------------------------------------------------------------------
# OpenRouter (https://openrouter.ai)
OPENROUTER_API_KEY=

# OpenAI (https://platform.openai.com)
OPENAI_API_KEY=

# DeepSeek (https://platform.deepseek.com)
DEEPSEEK_API_KEY=

# Google Gemini (https://aistudio.google.com)
GOOGLE_API_KEY=
GOOGLE_API_KEY_PAID=

# ------------------------------------------------------------------------------
# Web Search & Scraping API Keys
# ------------------------------------------------------------------------------
# Firecrawl (https://www.firecrawl.dev)
FIRECRAWL_API_KEY=

# Tavily AI Search (https://tavily.com)
TAVILY_API_KEY=

# Jina AI Reader (https://jina.ai)
JINA_API_KEY=

# Currents API (https://currentsapi.services)
CURRENTS_API_KEY=

# NewsData API (https://newsdata.io)
NEWSDATA_API_KEY=

# ------------------------------------------------------------------------------
# LangChain / LangSmith Observability & Tracing
# ------------------------------------------------------------------------------
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=viral-thread-generator
LANGSMITH_API_KEY=

# ------------------------------------------------------------------------------
# Cloudflare Turnstile Bot Protection
# Register site key and secret at https://dash.cloudflare.com/?to=/:account/turnstile
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET=
