{
  "rules": [
    {
      "id": "@secretlint/secretlint-rule-preset-recommend"
    },
    {
      "id": "@secretlint/secretlint-rule-pattern",
      "options": {
        "patterns": [
          {
            "name": "Cloudflare Turnstile Secret / Site Key",
            "patterns": [
              "/0x4[A-Za-z0-9_-]{20,}/"
            ]
          }
        ]
      }
    }
  ]
}
